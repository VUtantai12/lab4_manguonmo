  "item": [
    {
      "name": "TC06 - POST /books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Trả về 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Có id và đúng ISBN\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.isbn).to.eql('9786040000011');",
              "    pm.environment.set(\"bookId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Lập trình Python\",\n  \"author\": \"Nguyễn Văn Hùng\",\n  \"isbn\": \"9786040000011\",\n  \"year\": 2024,\n  \"quantity\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
